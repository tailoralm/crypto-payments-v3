{
  "name": "cryptopay-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "knex migrate:latest --knexfile src/db/knexfile.ts",
    "migrate:rollback": "knex migrate:rollback --knexfile src/db/knexfile.ts",
    "seed": "knex seed:run --knexfile src/db/knexfile.ts",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 test/integration.ts test/merchant.integration.ts test/upgrade.ts"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "express-rate-limit": "^7.3.0",
    "helmet": "^8.3.0",
    "json-bigint": "^1.0.0",
    "jsonwebtoken": "^9.0.0",
    "knex": "^3.1.0",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/json-bigint": "^1.0.4",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^7.2.1",
    "nock": "^15.0.5",
    "smtp-server": "^3.21.1",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0"
  }
}

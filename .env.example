# Prefer: node scripts/setup.mjs (generates unique secrets without overwriting .env)
DB_NAME=cryptopay
DB_USER=cryptopay
DB_PASSWORD=replace-with-unique-random-secret
JWT_SECRET=replace-with-unique-random-secret-at-least-32-characters
ENCRYPTION_KEY=replace-with-unique-random-secret-at-least-32-characters
SETUP_TOKEN=replace-with-unique-random-secret-at-least-32-characters
# localhost by default. For a public reverse proxy, configure reachability deliberately.
BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
# Set true when accessed via HTTPS.
COOKIE_SECURE=false
DISABLE_POLLER=false
